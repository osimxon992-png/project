# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Telegram (@BotFather)
BOT_TOKEN=123456:ABC...
BOT_USERNAME=sahifa_bot
# Any random string, also passed to setWebhook as secret_token
TELEGRAM_WEBHOOK_SECRET=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Comma-separated Telegram user ids
ADMIN_TELEGRAM_IDS=123456789

# Public URL without trailing slash
NEXT_PUBLIC_SITE_URL=https://sahifa.uz

# Vercel sends "Authorization: Bearer $CRON_SECRET" to cron routes
CRON_SECRET=
